# Copy to backend/.env for local overrides (optional — the `local` profile has working defaults),
# or set these as real environment variables (Render dashboard / STS Run Configuration > Environment).
# Never commit a real .env file.

# JDBC form is required. Neon shows postgres://user:pass@host/db — convert to:
#   jdbc:postgresql://host/db?sslmode=require   (user/password go in the two variables below)
DATABASE_URL=jdbc:postgresql://localhost:5432/editflow
DATABASE_USERNAME=editflow
DATABASE_PASSWORD=editflow

# Comma-separated list of allowed frontend origins (no wildcard).
FRONTEND_URL=http://localhost:5173

# JWT signing secret (>= 32 bytes). Required outside the local profile.
#   openssl rand -base64 48
JWT_SECRET=
JWT_TTL_MINUTES=480

# Admin account created on first startup if none exists (password >= 8 chars).
ADMIN_EMAIL=admin@editflow.local
ADMIN_PASSWORD=
ADMIN_NAME=EditFlow Admin

# Timezone used for "today" (due today / overdue).
APP_TIMEZONE=Asia/Kolkata

# Production only: set to `prod`. Leave unset locally (defaults to `local`).
# SPRING_PROFILES_ACTIVE=prod
